# ============================================================
# ZERIVEX ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================
# COPY TO .env.local FOR LOCAL DEVELOPMENT.
# NEVER COMMIT REAL CREDENTIALS, API KEYS, OR PASSWORDS TO GIT.
# ============================================================

# Platform Environment
NODE_ENV=
PORT=
NEXT_PUBLIC_APP_URL=

# Core Database (PostgreSQL Connection String)
DATABASE_URL=
DATABASE_DIRECT_URL=

# Security & Session Secrets
# Generate using: openssl rand -base64 32
SESSION_SECRET=
CSRF_SECRET=

# Owner Bootstrap (One-time bootstrap email)
# Once bootstrapped, this value is permanently ignored by the server.
INITIAL_OWNER_EMAIL=

# Google OAuth 2.0 / OIDC Credentials
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Credentials
# Authorization callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Scanner Configuration & Safety Boundaries
SCANNER_MAX_CONCURRENT_JOBS=
SCANNER_REQUEST_TIMEOUT_MS=
SCANNER_MAX_RESPONSE_BYTES=
SCANNER_WORKER_ISOLATION_MODE=

# Logging & Telemetry (Optional / Later phases)
LOG_LEVEL=
SENTRY_DSN=

# Email / Notifications (Later phases - Optional for Phase 1)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Object Storage / Evidence Vault (Later phases - Optional for Phase 1)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payments & Billing (Phase 11 - Optional for Phase 1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=

# Production ingress: enable only behind a proxy that sanitizes forwarding headers
TRUST_PROXY_HEADERS=false
# Optional custom PostgreSQL CA PEM (certificate verification remains enabled)
DATABASE_SSL_CA=
# Disposable database for isolated regression checks; never use application data
TEST_DATABASE_URL=
# Visual QA screenshots (defaults to artifacts/screenshots)
ZERIVEX_SCREENSHOT_DIR=

# Staff access: allow individual accounts; never allow an entire public email domain.
STAFF_ALLOWED_EMAILS=
STAFF_ALLOWED_EMAIL_DOMAINS=
STAFF_BOOTSTRAP_OWNER_EMAIL=

# Public policy drafts. Set approval only after reviewing all published policies.
NEXT_PUBLIC_CONTACT_EMAIL=code64816@gmail.com
LEGAL_OPERATOR_NAME=
LEGAL_JURISDICTION=
LEGAL_POLICIES_APPROVED=false
