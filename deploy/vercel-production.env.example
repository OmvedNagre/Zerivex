# Safe template only: replace placeholders privately before importing into Vercel.
# Select Production; do not share production credentials with Preview deployments.
NEXT_PUBLIC_APP_URL=https://www.zerivex.tech
NEXT_PUBLIC_CONTACT_EMAIL=zerivex.secure@gmail.com

DATABASE_URL=REPLACE_WITH_PRODUCTION_POOLED_POSTGRES_URL
# Needed by direct database administration/migration tooling, not ordinary web requests.
DATABASE_DIRECT_URL=REPLACE_WITH_PRODUCTION_DIRECT_POSTGRES_URL
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Customer Google sign-in and separate staff Google sign-in use this client.
GOOGLE_CLIENT_ID=REPLACE_WITH_WEBSITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_WEBSITE_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=REPLACE_WITH_WEBSITE_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_WEBSITE_GITHUB_CLIENT_SECRET
STAFF_ALLOWED_EMAILS=code64816@gmail.com
STAFF_PORTAL_ENABLED=true

# Sender is verified by mail:connect as zerivex.secure@gmail.com.
GMAIL_CLIENT_ID=REPLACE_WITH_GMAIL_SENDER_CLIENT_ID
GMAIL_CLIENT_SECRET=REPLACE_WITH_GMAIL_SENDER_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=REPLACE_WITH_GMAIL_REFRESH_TOKEN_FROM_LOCAL_CONNECTION

WORKER_HEALTH_PORT=8081
WORKER_MONITOR_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRUST_PROXY_HEADERS=false

LEGAL_OPERATOR_NAME=Zerivex
LEGAL_POLICIES_APPROVED=false
# Add LEGAL_JURISDICTION after determining the correct governing country/state.
# Set LEGAL_POLICIES_APPROVED=true only after actual policy review.

# Optional tuning; these match current defaults.
SCANNER_MAX_CONCURRENT_JOBS=5
SCANNER_REQUEST_TIMEOUT_MS=15000
SCANNER_MAX_RESPONSE_BYTES=10485760

# Add these when enabling Stripe. Keep secret key and webhook endpoint in the same mode.
# STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET

# Only needed for a database that requires a custom certificate authority.
# DATABASE_SSL_CA=REPLACE_WITH_CA_PEM
